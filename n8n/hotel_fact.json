    {
      "id": "code-result",
      "name": "Code - Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "jsCode": "// Що записано (для того, хто кликав)\nconst b = $('Code - Build Fact').first().json;\nif (b._skip) return [{ json: { ok: false, ...b } }];\nconst st = (name) => { try { const j = $(name).first().json; return j && j.statusCode ? j.statusCode : null; } catch (e) { return null; } };\nconst ok = (c) => c == null || (c >= 200 && c < 300);\nreturn [{ json: {\n  ok: ok(st('HTTP - Patch Hotel')) && ok(st('HTTP - Insert Insight')),\n  hotel_id: b.hotel_id, field: b.field, mode: b.mode,\n  hotel_status: b.patch ? st('HTTP - Patch Hotel') : 'skip',\n  price_status: b.price ? st('HTTP - Patch Price') : 'skip',\n  insight_id: b.insight.insight_id, insight_status: st('HTTP - Insert Insight')\n} }];"
      },
      "executeOnce": true
    }
