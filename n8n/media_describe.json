      "name": "OpenAI - Analyze Photo",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "resource": "image",
        "operation": "analyze",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "GPT-4O-MINI"
        },
        "inputType": "base64",
        "binaryPropertyName": "data",
        "text": "Опиши це фото готелю українською мовою для медіа-бібліотеки luxury travel-агентства: 1-2 атмосферних речення (наприклад: 'захід сонця з приватного пляжу, шезлонги, тиша'). Потім додай 3-6 коротких тегів англійською мовою (наприклад: beach, sunset, private, luxury, pool, room, spa, view). Поверни СТРОГО валідний JSON без жодного додаткового тексту, у форматі: {\"description\": \"...\", \"tags\": [\"...\", \"...\"]}",
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "W0SZsbrcQTP4Dcjx",
          "name": "n8n_easypanel_p2p_mira"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "code-parse-vision",
      "name": "Code - Parse Vision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "jsCode": "// Той самий розбір, що в WF-022; теги у форматі Postgres-масиву\nconst id = $('Code - Prepare').first().json.media_id;\nlet parsed;\ntry {\n  const message = Array.isArray($json) ? $json[0] : $json;\n  const block = message && Array.isArray(message.content) ? message.content[0] : null;\n  const raw = ((block && block.text) || '').trim().replace(/^```json\\s*|```$/g, '');\n  parsed = JSON.parse(raw);\n} catch (e) { parsed = { description: '', tags: [] }; }\nconst tags = (Array.isArray(parsed.tags) ? parsed.tags : []).map(t => String(t).replace(/[{}\",]/g, '').trim()).filter(Boolean);\nreturn [{ json: { media_id: id, description: parsed.description || '', tags_pg: '{' + tags.join(',') + '}' } }];"
      }
    },
