      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const s = {};\nfor (const r of $('Supabase - Get Settings').all()) s[r.json.key] = r.json.value;\nconst m = $('Supabase - Get Media').first().json;\nif (!m || !m.storage_path) throw new Error('media без storage_path: ' + $('Webhook').first().json.body.media_id);\nreturn [{ json: { media_id: m.media_id, url: String(s.supabase_url || '').replace(/\\/$/, '') + '/storage/v1/object/post-media/' + m.storage_path } }];"
      }
    },
