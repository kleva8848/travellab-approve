          }
        ]
      ]
    },
    "IF - Synced?": {
      "main": [
        [
          {
            "node": "Supabase - Mark Synced",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Supabase - Mark Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supabase - Mark Synced": {
      "main": [
        [
          {
            "node": "Code - Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supabase - Mark Error": {
      "main": [
        [
          {
            "node": "Code - Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Kyiv"
  }
}