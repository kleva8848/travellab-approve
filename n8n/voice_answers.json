    {
      "id": "code-parse-prompt",
      "name": "Code - Parse Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3520,
        0
      ],
      "parameters": {
        "jsCode": "const r = $json;\nconst user = 'ПИТАННЯ:\\n' + r.questions.map((q, i) => (i + 1) + '. [id: ' + q.id + '] ' + q.question).join('\\n') + '\\n\\nВІДПОВІДЬ ІРИНИ:\\n<<<\\n' + r.answer_text + '\\n>>>';\nreturn [{ json: { ...r, systemPrompt: \"Ти розбираєш відповідь Ірини (TravelLab, luxury travel) на питання агента для поста. Дано пронумеровані питання з id і її відповідь — часто це розшифровка голосового, можуть бути помилки розпізнавання.\\nДля кожного питання випиши, що вона відповіла: її словами, коротко (1–2 речення), без вступів. Нічого не вигадуй і не додавай від себе.\\nЦіни й дати — точно як сказала (число, валюта, місяць). Якщо на питання вона не відповіла або сказала «не знаю» — answer null.\\nОдна відповідь може стосуватись кількох питань — тоді розклади по відповідних id.\\nВідповідь — СТРОГО JSON без іншого тексту: {\\\"answers\\\": [{\\\"id\\\": \\\"<id питання>\\\", \\\"answer\\\": \\\"текст\\\" або null}]}\", userPrompt: user } }];"
      }
    },
