        3080,
        0
      ],
      "parameters": {
        "jsCode": "// Текст відповіді: розшифровка голосового або текст як є\nconst r = $('Code - Resolve').first().json;\nlet text = r.text || '';\nif (r.file_id) { try { text = String($('OpenAI - Transcribe').first().json.text || '').trim(); } catch (e) { text = ''; } }\nreturn [{ json: { ...r, answer_text: text } }];"
