# Задаються у Vercel → Project → Settings → Environment Variables (не комітити реальні значення)
# Токен бота Іри (BotFather). Лише тут і в n8n credential
TELEGRAM_BOT_TOKEN=
# Supabase TravelLab (той самий проєкт, що в n8n): Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Хто може відкрити апку: TG ID Іри і Влада через кому
ALLOWED_TG_IDS=
# Адміни (Влад): службові екрани, схвалення глобальних правил
ADMIN_TG_IDS=
# Секрет вебхука n8n «Review Action» (той самий, що в n8n credential «TravelLab Approve Webhook»; значення — у локальному .env.local)
N8N_WEBHOOK_SECRET=
